{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/artifact-lifecycle-core/artifact-lifecycle-approval.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "plan_sha256", "approved", "approved_by", "approved_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "artifact-lifecycle-approval.v1"},
    "operation": {"enum": ["quarantine", "purge"]},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approved": {"type": "boolean"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
